    "sentry:deploy": "sentry-cli releases deploys VERSION new -e ENVIRONMENT",
    "sentry:test": "node -e \"throw new Error('Test Sentry Error')\"",
    "dev": "npm start",
    "lint": "echo 'Linting désactivé pour le TP'",
